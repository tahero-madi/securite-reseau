#!/usr/bin/env bash
# lab — outil de pilotage du laboratoire 3-020 (poste de l'apprenant)
set -uo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"
. /opt/lab/lab.conf
LAB=/opt/lab
C_OK=$'\e[32m'; C_KO=$'\e[31m'; C_T=$'\e[1;36m'; C_0=$'\e[0m'
MACHINES="fw $CONTENEURS"
export LIBVIRT_DEFAULT_URI=qemu:///system

aide() {
cat <<EOF
${C_T}lab${C_0} — pilotage du laboratoire « Sécurisation des architectures réseaux »

  lab statut                    état des machines, adresses et outils
  lab urls                      adresses des interfaces web (pfSense, Greenbone, Zabbix…)
  lab shell <machine>           terminal sur une machine (compte stagiaire), sans réseau
                                — l'équivalent de la console série d'un fournisseur cloud
  lab root <machine>            idem en root
  lab console fw                console graphique de pfSense (menu console, dépannage)
  lab instantane <nom> [m…]     instantané de toutes les machines (ou de celles citées)
  lab instantanes               liste des instantanés
  lab restaurer <nom> [m…]      revient à un instantané (toutes les machines ou celles citées)
  lab reset [m…]                revient à l'état « initial » de début de formation
  lab demo-arp [secondes]       (formateur) démonstration encadrée d'usurpation ARP, TP 1
  lab topo                      rappel du plan d'adressage

Machines : $MACHINES
Pour l'accès normal, utilisez SSH comme sur un vrai réseau :  ssh stagiaire@10.1.20.10
EOF
}

est_conteneur() { [[ " $CONTENEURS " == *" $1 "* ]]; }
verifie_machine() { [[ " $MACHINES " == *" $1 "* ]] || { echo "Machine inconnue : $1 ($MACHINES)"; exit 1; }; }

topo() {
cat <<EOF
${C_T}Plan d'adressage du lab${C_0}
  « Internet » (lab-wan) 203.0.113.0/24 : fw .11 · cloud-gw .21 · ext .31 · routeur FAI (cette VM) .254
  LAN  (lab-lan) 10.1.10.0/24   : fw .1 · VOTRE POSTE (cette VM) .10 · client .20 · intrus .66
  SRV  (lab-srv) 10.1.20.0/24   : fw .1 · srv-int .10
  DMZ  (lab-dmz) 10.1.30.0/24   : fw .1 · web .10
  VPC  (lab-vpc) 10.101.1.0/24  : cloud-gw .1 (service « cloud »)
  Ports « miroir » pour Wireshark : v-client, v-intrus, v-srv-int, v-web, v-cloud-gw, v-cloud-gw1, v-ext
EOF
}

urls() {
  local gsa; gsa=$(cat $LAB/gsa.url 2>/dev/null || echo "http://127.0.0.1:9392")
cat <<EOF
  pfSense    https://10.1.10.1
  Greenbone  $gsa
  Zabbix     http://127.0.0.1:8080
  web (DMZ)  http://10.1.30.10   https://10.1.30.10   DVWA : /dvwa/   Juice Shop : http://10.1.30.10:3000
  cloud      https://10.101.1.1  (depuis srv-int, par le tunnel IPsec du TP 6)
EOF
}

statut() {
  echo "${C_T}Machines${C_0}"
  local e; e=$(virsh domstate fw 2>/dev/null || echo "absente")
  printf "  %-9s %-10s %s\n" fw "$e" "203.0.113.11 · 10.1.10.1 · 10.1.20.1 · 10.1.30.1"
  for c in $CONTENEURS; do
    e=$(lxc list "^$c\$" -c s --format csv 2>/dev/null); [ -n "$e" ] || e="absente"
    printf "  %-9s %-10s %s\n" "$c" "${e,,}" "$(lxc list "^$c\$" -c 4 --format csv 2>/dev/null | tr '\n' ' ' | sed 's/ (eth[0-9])//g')"
  done
  echo "${C_T}Outils (Docker)${C_0}"
  for p in greenbone-community-edition zabbix; do
    local n t
    t=$(docker ps -a --filter "label=com.docker.compose.project=$p" -q | wc -l)
    n=$(docker ps --filter "label=com.docker.compose.project=$p" -q | wc -l)
    printf "  %-28s %s conteneur(s) actif(s) sur %s\n" "$p" "$n" "$t"
  done
  echo "${C_T}Adresses web${C_0}"; urls
}

shell_m() { # mode machine
  local mode=$1 m=${2:-}; [ -n "$m" ] || { aide; exit 1; }
  verifie_machine "$m"
  if [ "$m" = fw ]; then echo "pfSense : utilisez « lab console fw » ou ssh admin@10.1.10.1 (si SSH activé)"; exit 1; fi
  if [ "$mode" = root ]; then exec lxc exec "$m" -- bash -l
  else exec lxc exec "$m" -- su - stagiaire; fi
}

console() {
  local u=${SUDO_USER:-}
  if [ -n "${DISPLAY:-}" ] && [ -n "$u" ]; then
    sudo -u "$u" DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-/home/$u/.Xauthority}" \
      virt-viewer -c qemu:///system fw >/dev/null 2>&1 &
    echo "Console de fw ouverte dans une fenêtre (Ctrl+Alt pour libérer la souris)."
  else
    echo "Pas d'affichage graphique : console série → virsh console fw (Ctrl+] pour quitter)"
  fi
}

cibles() { if [ $# -gt 0 ]; then for m in "$@"; do verifie_machine "$m"; done; echo "$@"; else echo "$MACHINES"; fi; }

instantane() {
  local nom=${1:-}; [ -n "$nom" ] || { echo "Usage : lab instantane <nom> [machines]"; exit 1; }; shift
  for m in $(cibles "$@"); do
    if [ "$m" = fw ]; then
      virsh snapshot-delete fw "$nom" >/dev/null 2>&1
      virsh snapshot-create-as fw "$nom" --atomic >/dev/null && echo "  ${C_OK}✓${C_0} fw" || echo "  ${C_KO}✗${C_0} fw"
    else
      lxc delete "$m/$nom" >/dev/null 2>&1
      lxc snapshot "$m" "$nom" && echo "  ${C_OK}✓${C_0} $m" || echo "  ${C_KO}✗${C_0} $m"
    fi
  done
}

instantanes() {
  echo "${C_T}fw${C_0}"; virsh snapshot-list fw --name 2>/dev/null | sed '/^$/d;s/^/  /'
  for c in $CONTENEURS; do
    echo "${C_T}$c${C_0}"; lxc query "/1.0/instances/$c/snapshots" 2>/dev/null | jq -r '.[]' | sed 's#.*/#  #'
  done
}

restaurer() {
  local nom=${1:-}; [ -n "$nom" ] || { echo "Usage : lab restaurer <nom> [machines]"; exit 1; }; shift
  for m in $(cibles "$@"); do
    if [ "$m" = fw ]; then
      virsh snapshot-revert fw "$nom" --running --force >/dev/null && echo "  ${C_OK}✓${C_0} fw" || echo "  ${C_KO}✗${C_0} fw (instantané absent ?)"
    else
      lxc restore "$m" "$nom" && lxc start "$m" >/dev/null 2>&1; echo "  ${C_OK}✓${C_0} $m"
    fi
  done
}

demo_arp() {
  local d=${1:-15}
  [ "$d" -le 60 ] 2>/dev/null || d=15
  cat <<EOF
${C_T}Démonstration encadrée — usurpation ARP sur le LAN du lab (${d} s)${C_0}
  intrus (10.1.10.66) annonce à client (10.1.10.20) qu'il est la passerelle 10.1.10.1.
  Observez sur le port miroir du client :  sudo tcpdump -ni v-client arp   (ou Wireshark sur v-client)
  Et la détection :                         sudo arpwatch -d -N -i v-client
  Arrêt automatique ; les tables ARP sont ensuite purgées.
EOF
  sleep 3
  lxc exec intrus -- sysctl -qw net.ipv4.ip_forward=1
  lxc exec intrus -- timeout "$d" arpspoof -i eth0 -t "$IP_CLIENT" "$FW_LAN" 2>&1 | sed -n '1,5p;$p'
  lxc exec intrus -- sysctl -qw net.ipv4.ip_forward=0
  lxc exec client -- ip neigh flush all
  echo "  Terminé : table ARP du client purgée."
}

case "${1:-aide}" in
  statut|status)       statut ;;
  urls)                urls ;;
  topo)                topo ;;
  shell)               shell_m stagiaire "${2:-}" ;;
  root)                shell_m root "${2:-}" ;;
  console)             console ;;
  instantane)          shift; instantane "$@" ;;
  instantanes)         instantanes ;;
  restaurer)           shift; restaurer "$@" ;;
  reset)               shift; restaurer initial "$@" ;;
  demo-arp)            demo_arp "${2:-15}" ;;
  *)                   aide ;;
esac
