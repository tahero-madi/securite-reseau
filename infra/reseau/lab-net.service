[Unit]
Description=Lab 3-020 : ponts réseau et filtrage de la VM hôte
After=network-online.target
Wants=network-online.target
Before=docker.service libvirtd.service snap.lxd.daemon.service snap.lxd.daemon.unix.socket

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/lab/lab-net.sh start
ExecStop=/opt/lab/lab-net.sh stop

[Install]
WantedBy=multi-user.target
